# Server configuration (copy to .env for local dev)

# Enable/disable account creation (false in production)
FEATURE_ACCOUNT_CREATION=true

# Data directory (encrypted blobs storage)
DATA_DIR=./data

# Server port
PORT=8080

# Log level (error, warn, info, debug, trace)
RUST_LOG=debug

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173
