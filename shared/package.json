{
  "name": "@vroooom/shared",
  "version": "0.1.0",
  "description": "Shared core: crypto, sync engine, types (web + mobile)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^1.4.0",
    "argon2-browser": "^1.18.0",
    "libsodium-wrappers": "^0.7.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "fast-check": "^3.19.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.0",
    "vitest": "^2.0.0"
  }
}
